               <col width="4%"/>
               <col width="96%"/>
               <tbody>
                  <tr>
                     <td valign="top">
                        <p class="oj-normal">3)</p>
                     </td>
                     <td valign="top">
                        <p class="oj-normal">à l'article 56, le montant de 5 186 000 EUR est remplacé par celui de 5 225 000 EUR;</p>
                     </td>
                  </tr>
               </tbody>
            </table>
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
               <col width="4%"/>
               <col width="96%"/>
               <tbody>
                  <tr>
                     <td valign="top">
                        <p class="oj-normal">4)</p>
                     </td>
                     <td valign="top">
                        <p class="oj-normal">à l'article 63, paragraphe 1, premier alinéa, le montant de 5 186 000 EUR est remplacé par celui de 5 225 000 EUR;</p>
                     </td>
                  </tr>
               </tbody>
            </table>
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
               <col width="4%"/>
               <col width="96%"/>
               <tbody>
                  <tr>
                     <td valign="top">
                        <p class="oj-normal">5)</p>
                     </td>
                     <td valign="top">
                        <p class="oj-normal">l'article 67, paragraphe 1, est modifié comme suit:</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                           <col width="4%"/>
                           <col width="96%"/>
                           <tbody>
                              <tr>
                                 <td valign="top">
                                    <p class="oj-normal">a)</p>
                                 </td>
                                 <td valign="top">
                                    <p class="oj-normal">au point a), le montant de 134 000 EUR est remplacé par celui de 135 000 EUR;</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                           <col width="4%"/>
