                  <td valign="top"  >
                     <p class="normal">2.</p>
                  </td>
                  <td valign="top"  >
                     <span>On page 137, Article 81(15), point (a):</span>
                  </td>
               </tr>
            </tbody>
         </table>
         <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <col width="20%"/>
            <col width="80%"/>
            <tbody>
               <tr>
                  <td valign="top"  >
                     <p class="oj-normal">
                        <span class="oj-italic">for:</span>
                     </p>
                  </td>
                  <td valign="top"  >
                     <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <col width="4%"/>
                        <col width="96%"/>
                        <tbody>
                           <tr>
                              <td valign="top"  >
                                 <p class="oj-normal">‘(a)</p>
                              </td>
                              <td valign="top"  >
                                 <p class="oj-normal">the criteria for the assessment of client’s knowledge and competence in accordance with paragraph 2;’,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </td>
               </tr>
            </tbody>
         </table>
