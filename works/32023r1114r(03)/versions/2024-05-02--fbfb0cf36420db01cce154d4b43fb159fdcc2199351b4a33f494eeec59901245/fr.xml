                  <td valign="top"  >
                     <p class="normal">2.</p>
                  </td>
                  <td valign="top"  >
                     <span>Page 137, article 81, paragraphe 15, point a):</span>
                  </td>
               </tr>
            </tbody>
         </table>
         <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <col width="20%"/>
            <col width="80%"/>
            <tbody>
               <tr>
                  <td valign="top"  >
                     <p class="oj-normal">
                        <span class="oj-italic">au lieu de:</span>
