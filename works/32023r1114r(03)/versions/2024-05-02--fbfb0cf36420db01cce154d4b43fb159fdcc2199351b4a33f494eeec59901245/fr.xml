            <col width="80%"/>
            <tbody>
               <tr>
                  <td valign="top"  >
                     <p class="oj-normal">
                        <span class="oj-italic">lire:</span>
                     </p>
                  </td>
                  <td valign="top"  >
                     <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <col width="4%"/>
                        <col width="96%"/>
                        <tbody>
                           <tr>
                              <td valign="top"  >
                                 <p class="oj-normal">«a)</p>
                              </td>
                              <td valign="top"  >
                                 <p class="oj-normal">les critères d’évaluation des connaissances et des compétences conformément au paragraphe 7;».</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
