                           <col width="96%"/>
                           <tbody>
                              <tr>
                                 <td valign="top"  >
                                    <p class="oj-normal">(a)</p>
                                 </td>
                                 <td valign="top"  >
                                    <p class="oj-normal">The text “shall, as applicable, comply with at least the normalised certificate policy (‘NCP’) requirements as specified in standard ETSI EN 319 411-1 version 1.4.1 (2023-10)” is replaced by the text “shall, as applicable, comply with standard ETSI TS 119 411-8 V1.1.1 (2025-10)”.</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
                     </td>
