               <div class="eli-title" id="art_2.tit_1">
                  <p class="oj-sti-art">Rectifications du règlement délégué (UE) 2019/979</p>
               </div>
               <p class="oj-normal">
                  <span class="oj-italic">(Ne concerne pas la version française)</span>
               </p>
