                  <tr class="oj-table">
                     <td valign="top" class="oj-table" colspan="2" >
                        <p class="oj-tbl-txt">
                           <span class="oj-bold">Item 7</span>. Data and standards used</p>
                     </td>
                  </tr>
                  <tr class="oj-table">
                     <td valign="top" class="oj-table"  >
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                           <col width="4%"/>
                           <col width="96%"/>
                           <tbody>
                              <tr>
                                 <td valign="top"  >
                                    <p class="oj-normal">(a)</p>
                                 </td>
                                 <td valign="top"  >
                                    <p class="oj-normal">Data input.</p>
                                 </td>
