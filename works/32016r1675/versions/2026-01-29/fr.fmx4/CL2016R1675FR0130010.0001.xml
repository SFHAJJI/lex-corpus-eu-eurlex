LL></ROW><ROW><CELL COL="1">1</CELL><CELL COL="2">Fédération de Russie</CELL></ROW></CORPUS></TBL></P></GR.SEQ><?CLG.MDFC ID="C013001M001000" IDREF="O013001M001000"?></GR.SEQ></CONTENTS></CONS.ANNEX></CONS.DOC></CONS.ACT>