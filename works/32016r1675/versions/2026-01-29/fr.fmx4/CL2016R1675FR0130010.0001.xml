 pays tiers à haut risque qui ont pris un engagement politique écrit à haut niveau de remédier aux carences constatées et qui ont élaboré un plan d'action avec le GAFI.</TXT></NP></TI></TITLE><?CLG.MDFO ID="O013001M002000" IDREF="C013001M002000" ACTION="REPLACED" LEVEL="STRUCTURE" COMMAND="EXPLICIT" ACTIVE.DOC="32026R0083" ACTIVE.LOC="AR:1 .AND. AX:0" MOD.LEVEL="1"?><TBL NO.SEQ="0001" COLS="2"><CORPUS><ROW TYPE="HEADER"><CELL COL="1" TYPE="HEADER">N<HT TYPE="SUP">o</HT></CELL><CELL COL="2" TYPE="HEADER">Pays tiers à haut risque</CELL></ROW><ROW><CELL COL="1">1</CELL><CELL COL="2">Afghanistan</CELL></ROW><ROW><CELL COL="1">2</CELL><CELL COL="2">Algérie</CELL></ROW><ROW><CELL COL="1">3</CELL><CELL COL="2">Angola</CELL></ROW><ROW><CELL COL="1">4</CELL><CELL COL="2">Bolivie</CELL></ROW><ROW><CELL COL="1">5</CELL><CELL COL="2">Îles Vierges britanniques</CELL></ROW><ROW><CELL COL="1">6</CELL><CELL COL="2">Cameroun</CELL></ROW><ROW><CELL COL="1">7</CELL><CELL COL="2">Côte d’Ivoire</CELL></ROW><ROW><CELL COL="1">8</CELL><CELL COL="2">République démocratique du Congo</CELL></ROW><ROW><CELL COL="1">9</CELL><CELL COL="2">Haïti</CELL></ROW><ROW><CELL COL="1">10</CELL><CELL COL="2">Kenya</CELL></ROW><ROW><CELL COL="1">11</CELL><CELL COL="2">Laos</CELL></ROW><ROW><CELL COL="1">12</CELL><CELL COL="2">Liban</CELL></ROW><ROW><CELL COL="1">13</CELL><CELL COL="2">Monaco</CELL></ROW><ROW><CELL COL="1">14</CELL><CELL COL="2">Myanmar/Birmanie</CELL></ROW><ROW><CELL COL="1">15</CELL><CELL COL="2">Namibie</CELL></ROW><ROW><CELL COL="1">16</CELL><CELL COL="2">Népal</CELL></ROW><ROW><CELL COL="1">17</CELL><CELL COL="2">Soudan du Sud</CELL></ROW><ROW><CELL COL="1">18</CELL><CELL COL="2">Syrie</CELL></ROW><ROW><CELL COL="1">19</CELL><CELL COL="2">Trinité-et-Tobago</CELL></ROW><ROW><CELL COL="1">20</CELL><CELL COL="2">Vanuatu</CELL></ROW><ROW><CELL COL="1">21</CELL><CELL COL="2">Venezuela</CELL></ROW><ROW><CELL COL="1">22</CELL><CELL COL="2">Viêt Nam</CELL></ROW><ROW><CELL COL="1">23</CELL><CEL